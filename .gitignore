# ============================
# PYTHON BUILD / CACHE FILES
# ============================
__pycache__/
*.pyc
*.pyo
*.pyd
# ============================
# VIRTUAL ENVIRONMENTS
# ============================
aider-env/
venv/
env/
# ============================
# AIDER INTERNAL FILES
# ============================
.aider*
!.gitignore
# ============================
# LOGS & OUTPUT
# ============================
logs/
logs/**
# Backtest results
*.csv
# Live simulation logs
*.json
# ============================
# CHARTS & IMAGES
# ============================
*.png
*.jpg
*.jpeg
# ============================
# BACKUP FOLDERS
# ============================
Backup/
Backup/**
# ============================
# SYSTEM FILES
# ============================
.DS_Store
Thumbs.db
desktop.ini
# ============================
# API KEYS / SECRETS
# ============================
API KEY FROM OPEN CODE.txt
*.key
*.secret
*.token
# Test fixtures are inputs to the suite, not engine output.
# The pinned dataset and the golden snapshot must be in the repo or the
# tests cannot run on a clone.
!tests/fixtures/*.csv
!tests/fixtures/*.json